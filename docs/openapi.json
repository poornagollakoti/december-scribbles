  "info": {
    "title": "December Scribbles API",
    "description": "Public content, gallery and enquiry endpoints, plus session-authenticated administration. All errors use the `ApiError` shape: { statusCode, error, message, details?, requestId, path, timestamp }.",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "ds_session"
      }
    },
    "schemas": {
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "admin@example.com"
          },
          "password": {
            "type": "string",
            "format": "password"
          }
        },
        "required": ["email", "password"]
      },
      "UpdateMediaDto": {
        "type": "object",
        "properties": {
          "altText": {
            "type": "string",
            "maxLength": 300
          }
        },
        "required": ["altText"]
      },
      "CreateContentDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 160
          },
          "slug": {
            "type": "string",
            "maxLength": 120,
            "description": "Generated from the title if omitted"
          },
          "excerpt": {
            "type": "object",
            "maxLength": 300,
            "nullable": true
          },
          "body": {
            "type": "string",
            "maxLength": 20000,
            "description": "Plain text; line breaks are preserved"
          },
          "kind": {
            "type": "string",
            "enum": ["POEM", "QUOTE", "PROSE", "BOOK_NOTE"]
          },
          "status": {
            "type": "string",
            "enum": ["DRAFT", "PUBLISHED", "ARCHIVED"]
          },
          "coverImageId": {
            "type": "object",
            "format": "uuid",
            "nullable": true
          }
        },
        "required": ["title", "body", "kind", "status"]
      },
      "UpdateContentDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 160
          },
          "slug": {
            "type": "string",
            "maxLength": 120,
            "description": "Generated from the title if omitted"
          },
          "excerpt": {
            "type": "object",
            "maxLength": 300,
            "nullable": true
          },
          "body": {
            "type": "string",
            "maxLength": 20000,
            "description": "Plain text; line breaks are preserved"
          },
          "kind": {
            "type": "string",
            "enum": ["POEM", "QUOTE", "PROSE", "BOOK_NOTE"]
          },
          "status": {
            "type": "string",
            "enum": ["DRAFT", "PUBLISHED", "ARCHIVED"]
          },
          "coverImageId": {
            "type": "object",
            "format": "uuid",
            "nullable": true
          }
        }
      },
      "CreateGalleryItemDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 160
          },
          "slug": {
            "type": "string",
            "maxLength": 120,
            "description": "Generated from the title if omitted"
          },
          "description": {
            "type": "object",
            "maxLength": 2000,
            "nullable": true
          },
          "category": {
            "type": "object",
            "maxLength": 60,
            "nullable": true
          },
          "imageId": {
            "type": "string",
            "format": "uuid"
          },
          "altText": {
            "type": "string",
            "maxLength": 300,
            "description": "Describes the image for screen readers"
          },
          "displayOrder": {
            "type": "number",
            "default": 0
          },
          "isPublished": {
            "type": "boolean",
            "default": false
          },
          "instagramUrl": {
            "type": "object",
            "nullable": true,
            "example": "https://www.instagram.com/p/AbC123/",
            "description": "Link to the original Instagram post or reel"
          }
        },
        "required": ["title", "imageId", "altText"]
      },
      "UpdateGalleryItemDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 160
          },
          "slug": {
            "type": "string",
            "maxLength": 120,
            "description": "Generated from the title if omitted"
          },
          "description": {
            "type": "object",
            "maxLength": 2000,
            "nullable": true
          },
          "category": {
            "type": "object",
            "maxLength": 60,
            "nullable": true
          },
          "imageId": {
            "type": "string",
            "format": "uuid"
          },
          "altText": {
            "type": "string",
            "maxLength": 300,
            "description": "Describes the image for screen readers"
          },
          "displayOrder": {
            "type": "number",
            "default": 0
          },
          "isPublished": {
            "type": "boolean",
            "default": false
          },
          "instagramUrl": {
            "type": "object",
            "nullable": true,
            "example": "https://www.instagram.com/p/AbC123/",
            "description": "Link to the original Instagram post or reel"
          }
        }
      },
      "CreateEnquiryDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100
          },
          "email": {
            "type": "string",
            "maxLength": 254
          },
          "type": {
            "type": "string",
            "enum": ["GENERAL", "COLLABORATION", "COMMISSION", "FEEDBACK"]
          },
          "subject": {
            "type": "string",
            "maxLength": 160
          },
          "message": {
            "type": "string",
            "minLength": 10,
            "maxLength": 5000
          },
          "website": {
            "type": "string",
            "description": "Honeypot field. Leave empty."
          }
        },
        "required": ["name", "email", "type", "message"]
      },
      "EnquiryStatusUpdateDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": ["NEW", "READ", "ARCHIVED"]
          }
        },
