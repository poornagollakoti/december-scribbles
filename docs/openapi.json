      },
      "UpdateSiteProfileDto": {
        "type": "object",
        "properties": {
          "displayName": {
            "type": "string",
            "maxLength": 160
          },
          "tagline": {
            "type": "string",
            "maxLength": 300
          },
          "aboutBody": {
            "type": "string",
            "maxLength": 20000,
            "description": "Plain text; paragraphs separated by blank lines"
          },
          "contactEmail": {
            "type": "object",
            "nullable": true
          },
          "instagramUrl": {
            "type": "object",
            "nullable": true
          },
          "aboutImageId": {
            "type": "object",
            "format": "uuid",
            "nullable": true,
