# December Scribbles website — copy to .env.local. Placeholder values only.

# Public URL of this website (canonical links, sitemap, Open Graph)
SITE_URL=http://localhost:3000

# Where the Next.js server reaches the NestJS API (server-side only, never sent to browsers).
# Browser requests go to /api/* on this site and are proxied there.
API_INTERNAL_URL=http://localhost:4000

# Base path the browser uses for API calls. Keep the default unless the API is served elsewhere.
NEXT_PUBLIC_API_BASE_URL=/api/v1
