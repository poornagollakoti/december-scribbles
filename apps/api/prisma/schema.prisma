// December Scribbles data model.
// Images are stored in object storage; the database keeps only keys and metadata.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EDITOR
}

enum ContentKind {
  POEM
  QUOTE
  PROSE
  BOOK_NOTE
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum EnquiryType {
  GENERAL
  COLLABORATION
  COMMISSION
  FEEDBACK
}

enum EnquiryStatus {
  NEW
  READ
  ARCHIVED
}

model AdminUser {
  id               String    @id @default(uuid()) @db.Uuid
  email            String    @unique
  name             String
  passwordHash     String
  role             Role      @default(EDITOR)
  isActive         Boolean   @default(true)
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  sessions Session[]
  uploads  MediaAsset[]
}

/// Server-side session. The cookie holds a random token; only its SHA-256 hash is stored.
model Session {
  id         String    @id @default(uuid()) @db.Uuid
  tokenHash  String    @unique
  userId     String    @db.Uuid
  user       AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime  @default(now())
  userAgent  String?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model MediaAsset {
  id           String     @id @default(uuid()) @db.Uuid
  /// Object key of the optimised full-size image (WebP).
  storageKey   String     @unique
  /// Object key of the thumbnail (WebP).
  thumbnailKey String     @unique
  originalName String
  mimeType     String
  sizeBytes    Int
  width        Int
  height       Int
  altText      String     @default("")
  uploadedById String?    @db.Uuid
  uploadedBy   AdminUser? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime   @default(now())

  contentCovers Content[]
  galleryItems  GalleryItem[]
  profileImages SiteProfile[]

  @@index([createdAt])
}

model Content {
  id           String        @id @default(uuid()) @db.Uuid
  slug         String        @unique
  title        String
  excerpt      String?
  /// Plain text. Line breaks are significant (poetry).
  body         String
  kind         ContentKind
  status       ContentStatus @default(DRAFT)
  /// Media in use cannot be deleted (Restrict) — unlink it first.
  coverImageId String?       @db.Uuid
  coverImage   MediaAsset?   @relation(fields: [coverImageId], references: [id], onDelete: Restrict)
  publishedAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status, publishedAt(sort: Desc)])
  @@index([kind, status])
}

model GalleryItem {
  id           String     @id @default(uuid()) @db.Uuid
  slug         String     @unique
  title        String
  description  String?
  category     String?
  imageId      String     @db.Uuid
  image        MediaAsset @relation(fields: [imageId], references: [id], onDelete: Restrict)
  altText      String
  displayOrder Int        @default(0)
  isPublished  Boolean    @default(false)
  /// Optional link to the original Instagram post (https://www.instagram.com/p/...).
  instagramUrl String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([isPublished, displayOrder])
  @@index([category])
}

model Enquiry {
  id                String        @id @default(uuid()) @db.Uuid
  name              String
  email             String
  type              EnquiryType   @default(GENERAL)
  subject           String?
  message           String
  status            EnquiryStatus @default(NEW)
  /// Set once the owner notification email has been sent.
  notifiedAt        DateTime?
  notificationError String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([status, createdAt(sort: Desc)])
}

/// Single-row table (id = 1) holding editable site-wide brand copy.
model SiteProfile {
  id           Int         @id @default(1)
  displayName  String
  tagline      String
  aboutBody    String      @default("")
  contactEmail String?
  instagramUrl String?
  /// Optional image for the About section (supplied by the owner).
  aboutImageId String?     @db.Uuid
  aboutImage   MediaAsset? @relation(fields: [aboutImageId], references: [id], onDelete: Restrict)
  updatedAt    DateTime    @updatedAt
}
