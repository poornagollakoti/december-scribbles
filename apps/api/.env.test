# Used only by `npm run test:e2e`. Points at the isolated test database created by docker/postgres-init.sql.
NODE_ENV=test
DATABASE_URL=postgresql://ds:ds_local_password@localhost:5433/december_scribbles_test?schema=public
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:3100
S3_ENDPOINT=http://localhost:9090
S3_REGION=us-east-1
S3_BUCKET=ds-media
S3_ACCESS_KEY_ID=local-placeholder
S3_SECRET_ACCESS_KEY=local-placeholder
S3_FORCE_PATH_STYLE=true
MEDIA_PUBLIC_BASE_URL=http://localhost:9090/ds-media
# Explicitly empty: Prisma Client also loads .env into process.env, so blank these to disable email.
SMTP_HOST=
ENQUIRY_NOTIFY_TO=
PORT=4100
