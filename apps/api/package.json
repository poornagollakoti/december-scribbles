{
  "name": "@ds/api",
  "version": "1.0.0",
  "private": true,
  "description": "December Scribbles REST API (NestJS)",
  "scripts": {
    "build": "prisma generate && nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\" \"prisma/**/*.ts\" \"scripts/**/*.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest",
    "test:cov": "jest --coverage",
    "test:e2e": "dotenv run -q -f .env.test --override -- prisma migrate deploy && dotenv run -q -f .env.test --override -- jest --config test/jest-e2e.config.js --runInBand",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "admin:create": "ts-node --transpile-only scripts/create-admin.ts",
    "openapi:export": "ts-node --transpile-only scripts/export-openapi.ts",
    "e2e:fixtures": "dotenv run -q -f .env.test --override -- prisma migrate deploy && dotenv run -q -f .env.test --override -- ts-node --transpile-only scripts/e2e-fixtures.ts",
    "start:test": "dotenv run -q -f .env.test --override -- node dist/main.js",
    "preview:load": "ts-node --transpile-only scripts/preview-content.ts load",
    "preview:remove": "ts-node --transpile-only scripts/preview-content.ts remove"
  },
  "prisma": {
    "seed": "ts-node --transpile-only prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1141.0",
    "@ds/contracts": "*",
    "@nestjs/common": "11.2.6",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.6",
    "@nestjs/platform-express": "11.2.6",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/terminus": "11.1.1",
    "@nestjs/throttler": "6.7.1",
    "@prisma/client": "6.19.3",
    "argon2": "0.45.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cookie-parser": "1.4.7",
    "helmet": "8.3.0",
    "nestjs-pino": "4.6.1",
    "nodemailer": "10.0.16",
    "pino-http": "10.5.0",
    "prisma": "6.19.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.6",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/multer": "2.2.0",
    "@types/node": "22.20.4",
    "@types/supertest": "7.2.1",
    "dotenv": "18.0.4",
    "eslint": "9.39.5",
    "jest": "30.5.2",
    "pino-pretty": "13.1.3",
    "source-map-support": "0.5.21",
    "supertest": "7.3.0",
    "ts-jest": "29.4.14",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1"
  }
}
