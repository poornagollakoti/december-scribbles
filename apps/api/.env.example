# ---------------------------------------------------------------------------
# December Scribbles API — copy to .env and adjust. Placeholder values only.
# Defaults below match docker-compose.yml for local development.
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Reverse-proxy hops in front of the API in production (e.g. 1 behind a load balancer)
TRUST_PROXY_HOPS=0

DATABASE_URL=postgresql://ds:ds_local_password@localhost:5433/december_scribbles?schema=public

# Browser origins allowed to call the API (comma-separated)
FRONTEND_ORIGINS=http://localhost:3000

# Admin sessions
SESSION_TTL_HOURS=168
# Defaults to true when NODE_ENV=production
# COOKIE_SECURE=true
# Defaults to false when NODE_ENV=production
# SWAGGER_ENABLED=true

# Object storage (S3-compatible). Local: S3Mock from docker-compose (ignores credentials).
S3_ENDPOINT=http://localhost:9090
S3_REGION=us-east-1
S3_BUCKET=ds-media
S3_ACCESS_KEY_ID=local-placeholder
S3_SECRET_ACCESS_KEY=local-placeholder
S3_FORCE_PATH_STYLE=true
MEDIA_PUBLIC_BASE_URL=http://localhost:9090/ds-media

# Email notifications for new enquiries (optional). Local: Mailpit, UI at http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="December Scribbles <no-reply@example.com>"
ENQUIRY_NOTIFY_TO=owner@example.com
