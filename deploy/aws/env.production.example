# Copy to .env.production ON THE SERVER and fill in. Never commit the real file.
# Placeholder values only.

# --- Site -----------------------------------------------------------------------------------
DOMAIN=decemberscribbles.example
ACME_EMAIL=you@example.com

# --- API ------------------------------------------------------------------------------------
NODE_ENV=production
LOG_LEVEL=info
# Caddy sets X-Forwarded-For to the visitor's IP (ignoring any client-supplied value) and Next.js
# passes it through unchanged, so the API trusts exactly one hop: the website container.
TRUST_PROXY_HOPS=1
FRONTEND_ORIGINS=https://decemberscribbles.example
SESSION_TTL_HOURS=168

# Amazon RDS PostgreSQL (endpoint from the RDS console). Keep sslmode=require.
DATABASE_URL=postgresql://ds_admin:CHANGE_ME@your-db.xxxxxxxx.ap-south-1.rds.amazonaws.com:5432/december_scribbles?schema=public&sslmode=require

# Amazon S3 (leave S3_ENDPOINT unset for AWS) + CloudFront for public reads.
S3_REGION=ap-south-1
S3_BUCKET=decemberscribbles-media
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
S3_FORCE_PATH_STYLE=false
MEDIA_PUBLIC_BASE_URL=https://dxxxxxxxxxxxxx.cloudfront.net

# Amazon SES SMTP (optional: without SMTP_HOST, enquiries are saved but no email is sent).
SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
MAIL_FROM="December Scribbles <no-reply@decemberscribbles.example>"
ENQUIRY_NOTIFY_TO=you@example.com
